# Frontend environment configuration for Personal Notes (React CRA)
# Copy this file to `.env` and adjust as needed.

# Backend API base URL (preferred)
REACT_APP_API_BASE=http://localhost:4000

# Legacy/alternate backend URL variable (used if REACT_APP_API_BASE is not set)
REACT_APP_BACKEND_URL=http://localhost:4000

# Public URL of the frontend (used for CORS or redirects by external services if needed)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket URL if the backend exposes WS endpoints
REACT_APP_WS_URL=

# Node environment flags (typical defaults for local)
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true

# Local dev server port for CRA
REACT_APP_PORT=3000

# Misc options
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
